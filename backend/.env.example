APP_NAME=DocSage
# SQLite by default. PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/docsage
DATABASE_URL=sqlite+aiosqlite:///./docsage.db
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
FRONTEND_URL=http://localhost:3000

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# Providers are tried in this order. One key is enough; free tiers exist.
LLM_PROVIDER_ORDER=groq,cerebras,openrouter
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# memory = vectors live in RAM and are rebuilt on start; http = Qdrant server (docker compose up -d)
QDRANT_MODE=memory
QDRANT_URL=http://localhost:6333

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=5
MIN_SCORE=0.25
OCR_ENABLED=true

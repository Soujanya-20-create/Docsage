APP_NAME=DocSage
# "production" refuses to start with a weak SECRET_KEY.
ENVIRONMENT=development
# SQLite by default. For PostgreSQL paste the URL your host gives you as is
# (postgres://..., postgresql://... and ?sslmode=require are all converted automatically).
DATABASE_URL=sqlite+aiosqlite:///./docsage.db
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Browser origins allowed to call the API, comma separated. Use your Vercel URL in production.
FRONTEND_URL=http://localhost:3000
# Optional: also allow Vercel preview deployments, e.g. https://docsage-.*\.vercel\.app
CORS_ORIGIN_REGEX=

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# Providers are tried in this order; a failing one is skipped for 60 s. One key is enough.
#   Groq        https://console.groq.com/keys
#   Cerebras    https://cloud.cerebras.ai/
#   OpenRouter  https://openrouter.ai/keys
# Verify them with: python -m docsage.check_llm
LLM_PROVIDER_ORDER=groq,cerebras,openrouter
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# memory = vectors live in RAM and are rebuilt on start (fine locally).
# http   = a Qdrant server: `docker compose up -d` locally, or a free Qdrant Cloud cluster in production.
QDRANT_MODE=memory
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=5
MIN_SCORE=0.25
OCR_ENABLED=true
OCR_LANGUAGES=eng
# Only needed when Tesseract is not on PATH (the Windows installer default is auto-detected).
TESSERACT_CMD=

# ---- Sign-in and platform security -----------------------------------------------------------
# Shared secret between the Next.js server (BFF) and this API so the real visitor IP is rate limited.
# Set the SAME value as BFF_SECRET in Vercel. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BFF_SECRET=
# How many reverse proxies sit in front of the API (Render and Railway = 1).
TRUSTED_PROXY_HOPS=1
# Optional Redis (rate limits shared across instances). Empty = in-memory, fine for one instance.
REDIS_URL=
# Run database migrations when the API starts.
AUTO_MIGRATE=true

# ---- Email (confirmation and password reset) -------------------------------------------------
# Use Resend (https://resend.com) or any SMTP server. With neither, emails are only logged (dev).
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=DocSage <onboarding@resend.dev>
# true = people must confirm their email before uploading or asking. Needs email configured above.
REQUIRE_EMAIL_VERIFICATION=false

# ---- Limits and monitoring -------------------------------------------------------------------
MAX_DOCUMENTS_PER_USER=50
MAX_STORAGE_MB_PER_USER=200
MAX_PDF_PAGES=300
# Optional error reporting (no personal data is sent).
SENTRY_DSN=

# ---- Demo account (development only) ---------------------------------------------------------
# Creates one verified account on startup so you can sign in without registering. Ignored in production.
# The values are never shown in the web app. Leave both empty to disable.
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_NAME=Demo User

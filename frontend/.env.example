# URL of the FastAPI backend (https, no trailing slash). Baked in at build time: redeploy after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side URL for the sign-in proxy. Optional: defaults to NEXT_PUBLIC_API_URL.
API_URL=

# Shared secret with the backend (same value as BFF_SECRET there) so the real visitor IP is rate limited.
BFF_SECRET=

# Shown in the Terms, Privacy and Contact pages. Replace before launch.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_JURISDICTION=
